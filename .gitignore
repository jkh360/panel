# Ignore everything by default. Explicitly allow the publishable source tree.
*

!/.gitignore
!/.gitmodules
!/Cargo.toml
!/Cargo.lock
!/LICENSE
!/README.md
!/ARCHITECTURE.md
!/flake.nix
!/flake.lock

!/hn/
!/hn/SECURITY.md
!/hn/build.sh
!/hn/sandbox.sh
!/hn/net-sandbox.sh
!/hn/test-sandbox.sh

!/vendor/
!/vendor/haruneko

!/src/
!/src/*.rs
